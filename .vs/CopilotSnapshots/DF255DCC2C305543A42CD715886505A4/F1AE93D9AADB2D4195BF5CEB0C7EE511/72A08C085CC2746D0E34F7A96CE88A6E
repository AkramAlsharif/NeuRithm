@page "/not-found"
@layout MainLayout

<PageTitle>Not Found - Neurithm</PageTitle>

<div class="not-found-page">
    <div class="not-found-content">
        <h1>404 - Page Not Found</h1>
        <p>Sorry, the content you are looking for does not exist or has been moved.</p>
        <a href="/" class="btn btn-primary">Back to Home</a>
    </div>
</div>

<style>
    .not-found-page {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 60vh;
        text-align: center;
    }

    .not-found-content {
        padding: 2rem;
    }

    .not-found-content h1 {
        font-size: 3rem;
        color: #667eea;
        margin-bottom: 1rem;
    }

    .not-found-content p {
        font-size: 1.2rem;
        color: #666;
        margin-bottom: 2rem;
    }

    .btn {
        display: inline-block;
        padding: 0.75rem 1.5rem;
        background: #667eea;
        color: white;
        text-decoration: none;
        border-radius: 4px;
        font-weight: 600;
        transition: all 0.3s;
    }

    .btn:hover {
        background: #5568d3;
        transform: translateY(-2px);
    }
</style>