@page "/level-selector"
@using Neurithm.Core.Interfaces
@using Neurithm.Application.DTOs
@inject ILevelService LevelService
@inject NavigationManager Navigation

<PageTitle>Level Selector - Neurithm</PageTitle>

<div class="level-selector-page">
    <h1>Select Level</h1>

    <div class="filter-section">
        <button class="filter-btn" @onclick="@(() => FilterByDifficulty(""))" 
                style="@(selectedDifficulty == "" ? "background: #667eea; color: white;" : "")">
            All Levels
        </button>
        <button class="filter-btn" @onclick="@(() => FilterByDifficulty("Beginner"))" 
                style="@(selectedDifficulty == "Beginner" ? "background: #667eea; color: white;" : "")">
            Beginner
        </button>
        <button class="filter-btn" @onclick="@(() => FilterByDifficulty("Intermediate"))" 
                style="@(selectedDifficulty == "Intermediate" ? "background: #667eea; color: white;" : "")">
            Intermediate
        </button>
        <button class="filter-btn" @onclick="@(() => FilterByDifficulty("Advanced"))" 
                style="@(selectedDifficulty == "Advanced" ? "background: #667eea; color: white;" : "")">
            Advanced
        </button>
    </div>

    <div class="levels-grid">
        @if (filteredLevels != null && filteredLevels.Any())
        {
            @foreach (var level in filteredLevels)
            {
                <div class="level-card" @onclick="@(() => SelectLevel(level.Id))">
                    <div class="level-header">
                        <h3>@level.Title</h3>
                        <span class="difficulty-badge" style="@GetDifficultyStyle(level.Difficulty)">@level.Difficulty</span>
                    </div>

                    <p class="composer">By @level.Composer</p>

                    <p class="preview">@level.PreviewText</p>

                    <div class="level-details">
                        <div class="detail-item">
                            <span class="label">BPM:</span>
                            <span class="value">@level.BPM</span>
                        </div>
                        <div class="detail-item">
                            <span class="label">Notes:</span>
                            <span class="value">@level.Notes.Count</span>
                        </div>
                        <div class="detail-item">
                            <span class="label">Duration:</span>
                            <span class="value">@level.GetDurationSeconds().ToString("F0")s</span>
                        </div>
                    </div>

                    <button class="btn btn-primary btn-play">Play Level</button>
                </div>
            }
        }
        else
        {
            <div class="no-levels">
                <p>No levels found. Check back soon!</p>
            </div>
        }
    </div>

    <div class="back-button">
        <button class="btn btn-secondary" @onclick="@(() => Navigation.NavigateTo("/"))">Back to Home</button>
    </div>
</div>

@code {
    private IEnumerable<Neurithm.Core.Models.GameLevel>? allLevels;
    private IEnumerable<Neurithm.Core.Models.GameLevel>? filteredLevels;
    private string selectedDifficulty = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            allLevels = await LevelService.GetAllLevelsAsync();
            filteredLevels = allLevels;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading levels: {ex.Message}");
        }
    }

    private void FilterByDifficulty(string difficulty)
    {
        selectedDifficulty = difficulty;
        if (string.IsNullOrEmpty(difficulty))
        {
            filteredLevels = allLevels;
        }
        else
        {
            filteredLevels = allLevels?.Where(l => l.Difficulty == difficulty);
        }
    }

    private void SelectLevel(string levelId)
    {
        Navigation.NavigateTo($"/game/{levelId}");
    }

    private string GetDifficultyStyle(string difficulty)
    {
        return difficulty switch
        {
            "Beginner" => "background: #2ECC71; color: white;",
            "Intermediate" => "background: #F39C12; color: white;",
            "Advanced" => "background: #E74C3C; color: white;",
            _ => "background: #95a5a6; color: white;"
        };
    }
}

<style>
    .level-selector-page {
        max-width: 1200px;
        margin: 0 auto;
    }

    .level-selector-page h1 {
        text-align: center;
        margin-bottom: 2rem;
        font-size: 2.5rem;
    }

    .filter-section {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-bottom: 2rem;
        flex-wrap: wrap;
    }

    .filter-btn {
        padding: 0.75rem 1.5rem;
        border: 1px solid #ddd;
        border-radius: 4px;
        background: white;
        cursor: pointer;
        font-size: 1rem;
        font-weight: 500;
        transition: all 0.3s;
    }

    .filter-btn:hover {
        border-color: #667eea;
        background: #f5f5f5;
    }

    .levels-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 2rem;
        margin: 2rem 0;
    }

    .level-card {
        background: white;
        border-radius: 8px;
        padding: 1.5rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        cursor: pointer;
        transition: all 0.3s;
        display: flex;
        flex-direction: column;
    }

    .level-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
    }

    .level-header {
        display: flex;
        justify-content: space-between;
        align-items: start;
        margin-bottom: 1rem;
        gap: 1rem;
    }

    .level-card h3 {
        margin: 0;
        font-size: 1.3rem;
        color: #333;
    }

    .difficulty-badge {
        padding: 0.25rem 0.75rem;
        border-radius: 4px;
        font-size: 0.85rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .composer {
        margin: 0 0 0.5rem;
        color: #666;
        font-style: italic;
    }

    .preview {
        margin: 0.5rem 0 1rem;
        color: #555;
        font-size: 0.95rem;
        flex-grow: 1;
    }

    .level-details {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin-bottom: 1rem;
        padding: 1rem;
        background: #f9f9f9;
        border-radius: 4px;
    }

    .detail-item {
        text-align: center;
    }

    .detail-item .label {
        display: block;
        font-size: 0.85rem;
        color: #999;
        margin-bottom: 0.25rem;
    }

    .detail-item .value {
        display: block;
        font-size: 1.2rem;
        font-weight: bold;
        color: #667eea;
    }

    .btn-play {
        width: 100%;
        padding: 0.75rem;
    }

    .no-levels {
        grid-column: 1 / -1;
        text-align: center;
        padding: 3rem;
        color: #999;
    }

    .back-button {
        text-align: center;
        margin-top: 2rem;
    }

    .btn {
        padding: 0.75rem 1.5rem;
        border: none;
        border-radius: 4px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-primary {
        background: #667eea;
        color: white;
    }

    .btn-primary:hover {
        background: #5568d3;
    }

    .btn-secondary {
        background: #f0f0f0;
        color: #333;
        border: 1px solid #ddd;
    }

    .btn-secondary:hover {
        background: #e8e8e8;
    }

    @media (max-width: 768px) {
        .level-card {
            min-height: auto;
        }

        .levels-grid {
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        .level-details {
            grid-template-columns: 1fr;
        }
    }
</style>
