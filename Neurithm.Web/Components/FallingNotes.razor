@namespace Neurithm.Web.Components
@using Neurithm.Application.Services

<div class="falling-notes-board" id="falling-notes-board">
    @if (Notes.Count == 0)
    {
        <p class="text-muted">No upcoming notes.</p>
    }
    else
    {
        @foreach (var note in Notes.Where(ShouldRenderNote))
        {
            <div class="@BuildNoteCss(note)"
                 style="@BuildNoteStyle(note)"
                 title="@note.Feedback">
                @if (IsPerfectFeedback(note.Feedback))
                {
                    <div class="falling-note-perfect-badge">PERFECT</div>
                }
                @note.NoteName
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<FallingNoteVisual> Notes { get; set; } = [];

    private const int LaneCount = 61;

    private static bool ShouldRenderNote(FallingNoteVisual note)
        => !note.IsResolved || note.TopPercent < 105;

    private static string BuildNoteCss(FallingNoteVisual note)
    {
        var classes = new List<string> { "falling-note" };

        if (note.IsInsideHitWindow)
        {
            classes.Add("in-window");
        }

        if (note.IsMissed)
        {
            classes.Add("missed");
        }
        else if (note.IsResolved)
        {
            classes.Add("resolved");
        }

        if (IsPerfectFeedback(note.Feedback))
        {
            classes.Add("perfect-hit");
        }

        return string.Join(" ", classes);
    }

    private static string BuildNoteStyle(FallingNoteVisual note)
    {
        var laneLeft = LaneToLeftPercent(note.LaneIndex);
        var laneWidth = LaneWidthPercent();
        return $"transform:translate3d(0,{note.TopPercent:0.###}%,0);left:{laneLeft:0.###}%;width:{laneWidth:0.###}%;height:{note.HeightPercent:0.##}%;";
    }

    private static bool IsPerfectFeedback(string feedback)
        => !string.IsNullOrWhiteSpace(feedback) && feedback.StartsWith("Perfect", StringComparison.OrdinalIgnoreCase);

    private static double LaneToLeftPercent(int laneIndex)
    {
        var clamped = Math.Clamp(laneIndex, 0, LaneCount - 1);
        return (clamped * 100.0) / LaneCount;
    }

    private static double LaneWidthPercent() => 100.0 / LaneCount;
}

<style>
    .falling-notes-board {
        position: relative;
        width: 100%;
        min-height: 460px;
        border: 1px solid #3b0764;
        border-radius: 8px;
        background: rgba(0, 0, 0, 0.65);
        overflow: hidden;
    }

    .falling-note {
        position: absolute;
        top: 0;
        border-radius: 4px;
        border: 1px solid #8b5cf6;
        background: linear-gradient(180deg, rgba(147, 51, 234, 0.95), rgba(109, 40, 217, 0.95));
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.55rem;
        font-weight: 600;
        white-space: nowrap;
        overflow: visible;
        text-overflow: ellipsis;
        box-shadow: 0 0 12px rgba(168, 85, 247, 0.8);
        will-change: transform;
        backface-visibility: hidden;
    }

    .falling-note.in-window {
        box-shadow: 0 0 20px rgba(244, 114, 182, 0.95), 0 0 10px rgba(168, 85, 247, 0.8);
    }

    .falling-note.resolved {
        border-color: #a855f7;
        background: linear-gradient(180deg, rgba(139, 92, 246, 0.92), rgba(124, 58, 237, 0.92));
    }

    .falling-note.missed {
        border-color: #ef4444;
        background: linear-gradient(180deg, rgba(239, 68, 68, 0.95), rgba(185, 28, 28, 0.95));
        box-shadow: 0 0 10px rgba(239,68,68,0.85);
    }

    .falling-note-perfect-badge {
        position: absolute;
        bottom: calc(100% + 4px);
        left: 50%;
        transform: translateX(-50%);
        padding: 2px 8px;
        font-size: 0.52rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        color: #fff;
        background: linear-gradient(120deg, #ec4899, #60a5fa);
        border: 2px solid transparent;
        border-image: repeating-linear-gradient(135deg, #d8b4fe 0 6px, #c084fc 6px 12px) 1;
        border-radius: 6px;
        box-shadow: 0 0 10px rgba(216, 180, 254, 0.75);
        pointer-events: none;
        z-index: 4;
    }
</style>
