@namespace Neurithm.Web.Components
@using Neurithm.Application.Services

<div class="falling-notes-board" id="falling-notes-board">
    @if (Notes.Count == 0)
    {
        <p class="text-muted">No upcoming notes.</p>
    }
    else
    {
        @foreach (var note in Notes.Where(n => !n.IsResolved || n.TopPercent < 105))
        {
            var laneLeft = LaneToLeftPercent(note.LaneIndex);
            var laneWidth = LaneWidthPercent();
            <div class="falling-note @(note.IsInsideHitWindow ? "in-window" : null) @(note.IsMissed ? "missed" : null) @(note.IsResolved && !note.IsMissed ? "resolved" : null)"
                 style="top:@($"{note.TopPercent:0.##}%");left:@($"{laneLeft:0.###}%");width:@($"{laneWidth:0.###}%");height:@($"{note.HeightPercent:0.##}%")"
                 title="@note.Feedback">
                @note.NoteName
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<FallingNoteVisual> Notes { get; set; } = [];

    private const int LaneCount = 61;

    private static double LaneToLeftPercent(int laneIndex)
    {
        var clamped = Math.Clamp(laneIndex, 0, LaneCount - 1);
        return (clamped * 100.0) / LaneCount;
    }

    private static double LaneWidthPercent() => 100.0 / LaneCount;
}

<style>
    .falling-notes-board {
        position: relative;
        width: 100%;
        min-height: 460px;
        border: 1px solid #3b0764;
        border-radius: 8px;
        background: rgba(0, 0, 0, 0.65);
        overflow: hidden;
    }

    .falling-note {
        position: absolute;
        border-radius: 4px;
        border: 1px solid #8b5cf6;
        background: linear-gradient(180deg, rgba(147, 51, 234, 0.95), rgba(109, 40, 217, 0.95));
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.55rem;
        font-weight: 600;
        transition: top 0.05s linear;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        box-shadow: 0 0 12px rgba(168, 85, 247, 0.8);
    }

    .falling-note.in-window {
        box-shadow: 0 0 20px rgba(244, 114, 182, 0.95), 0 0 10px rgba(168, 85, 247, 0.8);
    }

    .falling-note.resolved {
        border-color: #a855f7;
        background: linear-gradient(180deg, rgba(139, 92, 246, 0.92), rgba(124, 58, 237, 0.92));
    }

    .falling-note.missed {
        border-color: #ef4444;
        background: linear-gradient(180deg, rgba(239, 68, 68, 0.95), rgba(185, 28, 28, 0.95));
        box-shadow: 0 0 10px rgba(239,68,68,0.85);
    }
</style>
