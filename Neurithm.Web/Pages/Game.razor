@page "/game"
@inject NavigationManager NavigationManager
@inject Neurithm.Web.Services.IClientLogService ClientLogService

<PageTitle>Game</PageTitle>

<h1>Game</h1>
@if (string.IsNullOrWhiteSpace(selectedLevelId))
{
    <p>No level selected yet. Use Level Selector to choose a level.</p>
}
else
{
    <p><strong>Selected level:</strong> @selectedLevelId</p>
}

<Neurithm.Web.Components.ScorePanel Score="score" Combo="combo" AccuracyPercentage="accuracy" />
<Neurithm.Web.Components.FallingNotes Notes="notes" />
<Neurithm.Web.Components.HitLine />
<Neurithm.Web.Components.PianoKeyboard Keys="extendedKeys" ActiveNote="activeNote" />

<div class="d-flex gap-2 mt-2">
    <button class="btn btn-primary" @onclick="StartLevelAsync">Start</button>
    <button class="btn btn-success" @onclick="MarkNextNoteAsync">Mark Next Note</button>
    <button class="btn btn-outline-secondary" @onclick="ResetLevelAsync">Reset</button>
</div>

@code {
    private string? selectedLevelId;
    private int score;
    private int combo;
    private double accuracy;
    private string? activeNote;
    private int noteIndex;

    private static readonly IReadOnlyList<string> extendedKeys = BuildKeys("C2", "C7");

    private IReadOnlyList<Neurithm.Web.Models.PlayableNote> notes =
    [
        new("E4", 0, 1),
        new("E4", 1, 1),
        new("F4", 2, 1),
        new("G4", 3, 1),
        new("A4", 4, 1)
    ];

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        selectedLevelId = GetQueryValue(uri.Query, "levelId");

        await ClientLogService.WriteAsync("Game", string.IsNullOrWhiteSpace(selectedLevelId)
            ? "Game opened without selected level"
            : $"Game opened with level: {selectedLevelId}");
    }

    private async Task StartLevelAsync()
    {
        score = 0;
        combo = 0;
        accuracy = 100;
        noteIndex = 0;
        activeNote = notes.Count > 0 ? notes[0].NoteName : null;
        await ClientLogService.WriteAsync("Game", "Start level clicked");
    }

    private async Task MarkNextNoteAsync()
    {
        if (notes.Count == 0)
        {
            return;
        }

        score += 3;
        combo += 1;
        accuracy = Math.Min(100, 90 + combo);

        noteIndex = (noteIndex + 1) % notes.Count;
        activeNote = notes[noteIndex].NoteName;

        await ClientLogService.WriteAsync("Game", $"Advanced to note {activeNote}; score={score}; combo={combo}");
    }

    private async Task ResetLevelAsync()
    {
        score = 0;
        combo = 0;
        accuracy = 0;
        noteIndex = 0;
        activeNote = null;
        await ClientLogService.WriteAsync("Game", "Reset level clicked");
    }

    private static string? GetQueryValue(string query, string key)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return null;
        }

        var trimmed = query.TrimStart('?');
        var pairs = trimmed.Split('&', StringSplitOptions.RemoveEmptyEntries);

        foreach (var pair in pairs)
        {
            var parts = pair.Split('=', 2);
            var currentKey = Uri.UnescapeDataString(parts[0]);
            if (!string.Equals(currentKey, key, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            return parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : string.Empty;
        }

        return null;
    }

    private static IReadOnlyList<string> BuildKeys(string startNote, string endNote)
    {
        var noteNames = new[] { "C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B" };
        var result = new List<string>();

        var start = NoteToMidi(startNote);
        var end = NoteToMidi(endNote);

        for (var midi = start; midi <= end; midi++)
        {
            var octave = (midi / 12) - 1;
            var name = noteNames[(midi % 12 + 12) % 12];
            result.Add($"{name}{octave}");
        }

        return result;
    }

    private static int NoteToMidi(string note)
    {
        var noteNames = new Dictionary<string, int>
        {
            ["C"] = 0, ["C#"] = 1, ["D"] = 2, ["D#"] = 3,
            ["E"] = 4, ["F"] = 5, ["F#"] = 6, ["G"] = 7,
            ["G#"] = 8, ["A"] = 9, ["A#"] = 10, ["B"] = 11
        };

        var pitch = note.Length == 3 ? note[..2] : note[..1];
        var octavePart = note[pitch.Length..];
        var octave = int.Parse(octavePart);
        return (octave + 1) * 12 + noteNames[pitch];
    }
}
