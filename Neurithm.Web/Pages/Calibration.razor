@page "/calibration"
@implements IAsyncDisposable
@inject Neurithm.Audio.IMicrophoneService MicrophoneService
@inject Neurithm.Audio.IPitchDetector PitchDetector
@inject Neurithm.Web.Services.IClientLogService ClientLogService

<PageTitle>Calibration</PageTitle>

<h1>Calibration</h1>
<p>Start microphone and verify note detection using your real piano.</p>

<div class="d-flex gap-2 mb-3">
    <button class="btn btn-primary" @onclick="StartMicAsync" disabled="@isCapturing">Start Microphone</button>
    <button class="btn btn-outline-secondary" @onclick="StopMicAsync" disabled="@(!isCapturing)">Stop Microphone</button>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-3">
        <label class="form-label">A4 tuning (Hz)</label>
        <input type="number" class="form-control" @bind="a4Frequency" @bind:event="oninput" @onchange="ApplyDetectorOptionsAsync" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Noise gate RMS</label>
        <input type="number" step="0.001" class="form-control" @bind="noiseGate" @bind:event="oninput" @onchange="ApplyDetectorOptionsAsync" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Confidence threshold</label>
        <input type="number" step="0.01" class="form-control" @bind="confidenceThreshold" @bind:event="oninput" @onchange="ApplyDetectorOptionsAsync" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Debounce (ms)</label>
        <input type="number" class="form-control" @bind="debounceMs" @bind:event="oninput" @onchange="ApplyDetectorOptionsAsync" />
    </div>
</div>

<Neurithm.Web.Components.MicrophoneStatusPanel
    PermissionStatus="@permissionStatus"
    LastError="@lastError"
    IsCapturing="@isCapturing"
    DetectedNote="@displayedNote"
    FrequencyHz="@frequencyHz"
    Reliability="@(isReliable ? "Reliable" : "Unreliable")" />

<div class="mb-3">
    <p><strong>Detected note:</strong> @displayedNote</p>
    <p><strong>Frequency:</strong> @frequencyHz.ToString("0.00") Hz</p>
    <p><strong>Confidence:</strong> @confidence.ToString("0.000")</p>
    <p><strong>Cents offset:</strong> @centsOffset.ToString("+0.0;-0.0;0.0")</p>
    <p><strong>Volume RMS:</strong> @volumeRms.ToString("0.0000")</p>
    <p><strong>Reliability:</strong> @(isReliable ? "Reliable" : "Unreliable")</p>
</div>

<Neurithm.Web.Components.PianoKeyboard Keys="extendedKeys" ActiveNote="activeNote" />

@code {
    private bool isCapturing;
    private string permissionStatus = "Not requested";
    private string? lastError;

    private string activeNote = "--";
    private string displayedNote = "No reliable note";
    private bool isReliable;

    private double frequencyHz;
    private double confidence;
    private double centsOffset;
    private double volumeRms;

    private double a4Frequency = 440.0;
    private double noiseGate = 0.012;
    private double confidenceThreshold = 0.55;
    private int debounceMs = 120;

    private static readonly IReadOnlyList<string> extendedKeys = BuildKeys("C2", "C7");

    protected override Task OnInitializedAsync()
    {
        var options = PitchDetector.GetOptions();
        a4Frequency = options.A4FrequencyHz;
        noiseGate = options.MinRmsForDetection;
        confidenceThreshold = options.MinConfidence;
        debounceMs = options.DebounceMilliseconds;

        MicrophoneService.DetectionAvailable += OnDetectionAvailableAsync;
        return Task.CompletedTask;
    }

    private async Task StartMicAsync()
    {
        var permission = await MicrophoneService.RequestPermissionAsync();
        permissionStatus = ToDisplay(permission.Status);
        lastError = permission.ErrorMessage;

        if (permission.Status != Neurithm.Audio.MicrophonePermissionStatus.Granted)
        {
            await ClientLogService.WriteAsync("Calibration", $"Microphone start blocked: {permissionStatus} ({lastError ?? "n/a"})");
            return;
        }

        await MicrophoneService.StartCaptureAsync((_, _) => Task.CompletedTask);

        isCapturing = MicrophoneService.IsCapturing;
        if (!isCapturing)
        {
            permissionStatus = ToDisplay(MicrophoneService.PermissionStatus);
            lastError = MicrophoneService.LastError;
            await ClientLogService.WriteAsync("Calibration", $"Microphone failed to start: {lastError ?? "unknown"}");
            return;
        }

        await ClientLogService.WriteAsync("Calibration", "Microphone capture started");
    }

    private async Task StopMicAsync()
    {
        await MicrophoneService.StopCaptureAsync();
        isCapturing = MicrophoneService.IsCapturing;
        await ClientLogService.WriteAsync("Calibration", "Microphone capture stopped");
    }

    private Task ApplyDetectorOptionsAsync()
    {
        var updated = PitchDetector.GetOptions();
        updated.A4FrequencyHz = Math.Clamp(a4Frequency, 430.0, 450.0);
        updated.MinRmsForDetection = Math.Clamp(noiseGate, 0.001, 0.200);
        updated.MinConfidence = Math.Clamp(confidenceThreshold, 0.10, 0.99);
        updated.DebounceMilliseconds = Math.Clamp(debounceMs, 50, 500);
        PitchDetector.UpdateOptions(updated);

        return ClientLogService.WriteAsync("Calibration", $"Detector options updated: A4={updated.A4FrequencyHz}, RMS={updated.MinRmsForDetection}, Confidence={updated.MinConfidence}, Debounce={updated.DebounceMilliseconds}");
    }

    private Task OnDetectionAvailableAsync(Neurithm.Audio.DetectedNoteResult detection)
    {
        frequencyHz = detection.FrequencyHz;
        confidence = detection.Confidence;
        centsOffset = detection.CentsOffset;
        volumeRms = detection.VolumeRms;
        isReliable = detection.IsReliable;

        if (detection.IsReliable)
        {
            activeNote = detection.NoteName;
            displayedNote = detection.NoteName;
        }
        else
        {
            displayedNote = string.IsNullOrWhiteSpace(detection.NoteName) || detection.NoteName == "--"
                ? "No reliable note"
                : $"{detection.NoteName} (unreliable)";
            activeNote = detection.NoteName == "--" ? activeNote : detection.NoteName;
        }

        return InvokeAsync(StateHasChanged);
    }

    private static string ToDisplay(Neurithm.Audio.MicrophonePermissionStatus status)
        => status switch
        {
            Neurithm.Audio.MicrophonePermissionStatus.NotRequested => "Not requested",
            Neurithm.Audio.MicrophonePermissionStatus.Granted => "Granted",
            Neurithm.Audio.MicrophonePermissionStatus.Denied => "Denied",
            Neurithm.Audio.MicrophonePermissionStatus.Blocked => "Browser/HTTPS blocked",
            Neurithm.Audio.MicrophonePermissionStatus.Error => "Error",
            _ => "Unknown"
        };

    private static IReadOnlyList<string> BuildKeys(string startNote, string endNote)
    {
        var noteNames = new[] { "C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B" };
        var result = new List<string>();

        var start = NoteToMidi(startNote);
        var end = NoteToMidi(endNote);

        for (var midi = start; midi <= end; midi++)
        {
            var octave = (midi / 12) - 1;
            var name = noteNames[(midi % 12 + 12) % 12];
            result.Add($"{name}{octave}");
        }

        return result;
    }

    private static int NoteToMidi(string note)
    {
        var noteNames = new Dictionary<string, int>
        {
            ["C"] = 0, ["C#"] = 1, ["D"] = 2, ["D#"] = 3,
            ["E"] = 4, ["F"] = 5, ["F#"] = 6, ["G"] = 7,
            ["G#"] = 8, ["A"] = 9, ["A#"] = 10, ["B"] = 11
        };

        var pitch = note.Length >= 3 && note[1] == '#'
            ? note[..2]
            : note[..1];

        var octavePart = note[pitch.Length..];
        var octave = int.Parse(octavePart);
        return (octave + 1) * 12 + noteNames[pitch];
    }

    public async ValueTask DisposeAsync()
    {
        MicrophoneService.DetectionAvailable -= OnDetectionAvailableAsync;
        if (isCapturing)
        {
            await MicrophoneService.StopCaptureAsync();
        }
    }
}
